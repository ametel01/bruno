{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run vercel-build",
  "ignoreCommand": "if [ \"${VERCEL_ENV:-}\" = \"production\" ] && [ \"${BRUNO_CANARY_VERIFIED_DEPLOY:-}\" != \"true\" ]; then exit 0; fi; exit 1",
  "crons": [
    {
      "path": "/api/internal/agent-deployments/reconcile",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/agent-runtime/reconcile",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/hermes-staging/reconcile",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/runner-infrastructure/reconcile",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/runner-replacements/reconcile",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/cold-deployment-slo/evaluate",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/operator/deletion",
      "schedule": "0 * * * *"
    }
  ]
}
