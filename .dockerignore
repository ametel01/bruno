# Default-deny the build context; re-include only runner runtime inputs.
*

!package.json
!bun.lock
!tsconfig.json
!src/
!src/runner-service/
!src/runner-service/**
!src/server/
!src/server/agents/
!src/server/agents/agent-id.ts
!docker/
!docker/hermes-optimized/
!docker/hermes-optimized/entrypoint.sh

# Secrets, credentials, and local service state must never enter Docker context.
.env
.env*
.vercel
.vercel/
.git
.git/
node_modules
node_modules/
.next
.next/
coverage
coverage/
test-results
test-results/
playwright-report
playwright-report/
*.log
*.pem
*.key
*.crt
*.p12
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
postgres-data
postgres-data/
pgdata
pgdata/
