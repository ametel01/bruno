DATABASE_URL=postgres://agentbay:agentbay@127.0.0.1:54329/agentbay
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Structured server logging defaults to info. Accepted values are trace, debug,
# info, warn, error, fatal, and silent. Production logs are newline-delimited JSON.
# AGENTBAY_LOG_LEVEL=info

# Authentication mode defaults to `development` only for non-Vercel loopback
# application URLs. Use `operator` with the existing Basic-auth password for a
# pre-Clerk production deployment, or `clerk` after the production cutover.
# AGENTBAY_AUTH_MODE=development
# AGENTBAY_OPERATOR_PASSWORD=replace-with-strong-operator-password
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-development-publishable-key
# CLERK_SECRET_KEY=replace-with-development-secret-key

# A Vercel production deployment may be made public for temporary development
# testing only when both values below are explicit. Remove the opt-in to restore
# fail-closed hosted behavior.
# AGENTBAY_AUTH_MODE=development
# AGENTBAY_ALLOW_PUBLIC_DEVELOPMENT=true

# A Vercel preview may use `development` only after an operator verifies that
# Deployment Protection has no bypass exceptions. This non-secret attestation
# must be exactly `true`; never put a protection bypass token in this file.
# AGENTBAY_PREVIEW_PROTECTION_VERIFIED=true

# Dashboard-side manual runner bootstrap. Use placeholders only in committed files.
# AGENTBAY_MANUAL_RUNNER_NAME=Manual VPS Runner
# AGENTBAY_MANUAL_RUNNER_ENDPOINT_URL=https://runner.example.com

# Shared temporary Milestone 11 bearer token for dashboard-to-runner requests.
# Replace locally or in deployment settings; never commit a real value.
AGENTBAY_RUNNER_BEARER_TOKEN=replace-with-manual-runner-token

# Optional DigitalOcean cloud runner provisioning. Use placeholders only in
# committed files; set real values in Vercel or local uncommitted env files.
# AGENTBAY_DIGITALOCEAN_TOKEN=replace-with-digitalocean-token
# AGENTBAY_DIGITALOCEAN_REGION=sfo3
# The legacy 512 MiB default is retained until provider evidence authorizes a
# new default, but hosted provisioning rejects it for the standard 1536 MiB
# Hermes limit plus runner/OS reserve. Use an explicitly selected supported
# profile such as s-1vcpu-2gb for managed Hermes cold-runner tests.
# AGENTBAY_DIGITALOCEAN_SIZE_SLUG=s-1vcpu-2gb
# AGENTBAY_DIGITALOCEAN_IMAGE=ubuntu-24-04-x64
# AGENTBAY_DIGITALOCEAN_TAGS=agentbay,agentbay-runner
# Defaults to auto-discovering account SSH keys through DigitalOcean. Use none
# only when intentionally creating runners without SSH access.
# AGENTBAY_DIGITALOCEAN_SSH_KEY_IDS=auto
# SSH inbound access is disabled by default even when SSH keys exist. Prefer a
# current operator IP CIDR for smoke tests; use public SSH only temporarily.
# AGENTBAY_DIGITALOCEAN_SSH_SOURCE_CIDRS=203.0.113.5/32
# AGENTBAY_DIGITALOCEAN_ALLOW_PUBLIC_SSH=false

# Images pulled by a newly provisioned runner. Hosted DigitalOcean provisioning
# requires an explicit immutable runner digest; tagged runner references are
# accepted only when AGENTBAY_DIGITALOCEAN_PROVIDER_MODE=local_docker.
# AGENTBAY_RUNNER_IMAGE=ghcr.io/ametel01/agentbay-runner:sha-release@sha256:replace-with-published-runner-digest
# AGENTBAY_HERMES_WORKLOAD_IMAGE=ghcr.io/ametel01/agentbay-hermes@sha256:replace-with-reviewed-amd64-manifest-digest
# AGENTBAY_HERMES_DOCKER_CPUS=1
# AGENTBAY_HERMES_DOCKER_MEMORY=1536m
# AGENTBAY_HERMES_DOCKER_PIDS_LIMIT=256

# Runner-service settings for the manual VPS host.
AGENTBAY_RUNNER_HOST=127.0.0.1
AGENTBAY_RUNNER_PORT=3045
# AGENTBAY_RUNNER_DOCKER_EXECUTABLE=docker
# AGENTBAY_DOCKER_RUNNER_IMAGE=busybox:1.36
# AGENTBAY_DOCKER_RUNNER_ARGS_JSON='["sh","-c","while true; do sleep 1; done"]'

# Capability-gated Hermes staging acceptance. These placeholders document the
# final live Telegram smoke prerequisites; keep real values in ignored local or
# hosted secret stores only. The default-disabled durable executor cannot start
# unless all capabilities and both exact authorization sentinels pass.
# AGENTBAY_HERMES_STAGING_PUBLISHED_IMAGE_REF=ghcr.io/ametel01/agentbay-hermes@sha256:replace-with-scanned-amd64-manifest-digest
# AGENTBAY_HERMES_STAGING_IMAGE_SOURCE_REVISION=replace-with-lowercase-40-hex-source-revision
# AGENTBAY_HERMES_STAGING_PUBLISH_WORKFLOW_RUN_ID=replace-with-successful-main-publish-run-id
# AGENTBAY_HERMES_STAGING_ACCEPTANCE_ENABLED=false
# AGENTBAY_HERMES_STAGING_ACCEPTANCE_BASE_URL=https://staging.example.com/
# AGENTBAY_HERMES_STAGING_ACCEPTANCE_BEARER_SECRET=replace-with-dedicated-32-to-256-character-secret
# AGENTBAY_HERMES_STAGING_DIGITALOCEAN_BUDGET_AUTHORIZATION=authorize-basic-4usd-digitalocean-staging
# AGENTBAY_HERMES_STAGING_ASSISTANT=chatgpt
# Set exactly one matching direct key. Use claude plus the Anthropic variable instead.
# AGENTBAY_HERMES_STAGING_OPENAI_API_KEY=replace-with-openai-platform-api-key
# AGENTBAY_HERMES_STAGING_ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# AGENTBAY_HERMES_STAGING_TELEGRAM_BOT_TOKEN=replace-with-dedicated-telegram-bot-token
# AGENTBAY_HERMES_STAGING_TELEGRAM_TEST_USER_ID=replace-with-numeric-telegram-user-id
# AGENTBAY_HERMES_STAGING_TELEGRAM_TEST_CHAT_ID=replace-with-numeric-telegram-chat-id
# AGENTBAY_HERMES_STAGING_LIVE_SIDE_EFFECT_CONFIRMATION=send-telegram-and-spend-digitalocean-staging

# Ready-mode writes direct OpenAI/Anthropic, Telegram, allowlist, and private API credentials
# encrypted. Generate a 32-byte base64url key, name its version, and retain old
# versions during rotation so existing agent secrets remain decryptable.
# AGENTBAY_AGENT_SECRET_ACTIVE_KEY_VERSION=v1
# AGENTBAY_AGENT_SECRET_KEYS_JSON={"v1":"replace-with-32-byte-base64url-key"}

# Opt-in automatic ready-mode agent creation. Set exactly true only in an
# environment that has passed the authorized live smoke. Leave unset or false
# to disable common new-agent setup; the stopped-create API is legacy operator compatibility only.
# AGENTBAY_READY_AGENT_CREATION_ENABLED=false

# Protects both one-item Vercel reconciliation routes: initial deployment and
# post-ready runtime convergence. Vercel sends it as Authorization: Bearer ... .
# Use a generated 32-256 character bearer-safe value in hosted secret storage.
# CRON_SECRET=replace-with-generated-cron-secret-at-least-32-chars

# Deployment retry wakeups default to protected cron recovery. Set qstash only
# after hosted secrets are configured completely; queue delivery is an accelerator
# and Postgres plus CRON_SECRET remain authoritative recovery.
# AGENTBAY_DEPLOYMENT_DISPATCH_MODE=cron
# QSTASH_TOKEN=replace-with-dedicated-qstash-token
# QSTASH_CURRENT_SIGNING_KEY=replace-with-current-qstash-signing-key
# QSTASH_NEXT_SIGNING_KEY=replace-with-next-qstash-signing-key
