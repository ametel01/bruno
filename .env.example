DATABASE_URL=postgres://bruno:bruno@127.0.0.1:54329/bruno
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Structured server logging defaults to info. Accepted values are trace, debug,
# info, warn, error, fatal, and silent. Production logs are newline-delimited JSON.
# BRUNO_LOG_LEVEL=info

# Authentication mode defaults to `development` only for non-Vercel loopback
# application URLs. Use `operator` with the existing Basic-auth password for a
# pre-Clerk production deployment, or `clerk` after the production cutover.
# BRUNO_AUTH_MODE=development
# BRUNO_OPERATOR_PASSWORD=replace-with-strong-operator-password
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-development-publishable-key
# CLERK_SECRET_KEY=replace-with-development-secret-key

# A Vercel production deployment may be made public for temporary development
# testing only when both values below are explicit. Remove the opt-in to restore
# fail-closed hosted behavior.
# BRUNO_AUTH_MODE=development
# BRUNO_ALLOW_PUBLIC_DEVELOPMENT=true

# A Vercel preview may use `development` only after an operator verifies that
# Deployment Protection has no bypass exceptions. This non-secret attestation
# must be exactly `true`; never put a protection bypass token in this file.
# BRUNO_PREVIEW_PROTECTION_VERIFIED=true

# Dashboard-side manual runner bootstrap. Use placeholders only in committed files.
# BRUNO_MANUAL_RUNNER_NAME=Manual VPS Runner
# BRUNO_MANUAL_RUNNER_ENDPOINT_URL=https://runner.example.com

# Shared temporary Milestone 11 bearer token for dashboard-to-runner requests.
# Replace locally or in deployment settings; never commit a real value.
BRUNO_RUNNER_BEARER_TOKEN=replace-with-manual-runner-token

# Optional DigitalOcean cloud runner provisioning. Use placeholders only in
# committed files; set real values in Vercel or local uncommitted env files.
# BRUNO_DIGITALOCEAN_TOKEN=replace-with-digitalocean-token
# BRUNO_DIGITALOCEAN_REGION=sfo3
# The legacy 512 MiB default is retained until provider evidence authorizes a
# new default, but hosted provisioning rejects it for the standard 1536 MiB
# Hermes limit plus runner/OS reserve. Use an explicitly selected supported
# profile such as s-1vcpu-2gb for managed Hermes cold-runner tests.
# BRUNO_DIGITALOCEAN_SIZE_SLUG=s-1vcpu-2gb
# BRUNO_DIGITALOCEAN_IMAGE=ubuntu-24-04-x64
# BRUNO_DIGITALOCEAN_TAGS=bruno,bruno-runner
# Defaults to auto-discovering account SSH keys through DigitalOcean. Use none
# only when intentionally creating runners without SSH access.
# BRUNO_DIGITALOCEAN_SSH_KEY_IDS=auto
# SSH inbound access is disabled by default even when SSH keys exist. Prefer a
# current operator IP CIDR for smoke tests; use public SSH only temporarily.
# BRUNO_DIGITALOCEAN_SSH_SOURCE_CIDRS=203.0.113.5/32
# BRUNO_DIGITALOCEAN_ALLOW_PUBLIC_SSH=false

# Authorized issue #299 Provider Trial operator. These exact values are local-only;
# use the ignored credential wizard documented in docs/E2E_VALIDATION.md instead of
# filling real credentials into this committed example. The command also requires
# the release-attested runner settings below and the normal agent-secret keyring.
# BRUNO_PROVIDER_TRIAL_AUTHORIZATION_ID=issue-299-20260811-g1
# BRUNO_PROVIDER_TRIAL_AUTHORIZATION_GENERATION=1
# BRUNO_PROVIDER_TRIAL_COHORT_KEY=issue-299-provider-trial-20260811-g1
# BRUNO_PROVIDER_TRIAL_LIVE_SIDE_EFFECT_CONFIRMATION=authorize-issue-299-live-provider-trial
# BRUNO_PROVIDER_TRIAL_ASSISTANT=chatgpt
# BRUNO_PROVIDER_TRIAL_MODEL_API_KEY=replace-with-dedicated-model-api-key
# BRUNO_PROVIDER_TRIAL_TELEGRAM_BOT_TOKEN=replace-with-dedicated-benchmark-bot-token
# BRUNO_PROVIDER_TRIAL_TELEGRAM_USER_ID=replace-with-numeric-test-user-id
# BRUNO_PROVIDER_TRIAL_TELEGRAM_CHAT_ID=replace-with-numeric-test-chat-id
# BRUNO_PROVIDER_TRIAL_SIGNING_KEY_ID=issue-299-ed25519-v1
# BRUNO_PROVIDER_TRIAL_SIGNING_PRIVATE_KEY_PATH=/absolute/ignored/path/private.pem
# BRUNO_PROVIDER_TRIAL_GATE_EVIDENCE_PATH=/absolute/ignored/path/prerequisite-gates.json
# BRUNO_PROVIDER_TRIAL_CREDENTIAL_FILE_PATH=/absolute/ignored/path/.env.provider-trial.local

# Images pulled by a newly provisioned runner. Hosted DigitalOcean provisioning
# requires an explicit immutable runner digest; tagged runner references are
# accepted only when BRUNO_DIGITALOCEAN_PROVIDER_MODE=local_docker.
# BRUNO_RUNNER_IMAGE=ghcr.io/ametel01/bruno-runner:sha-release@sha256:replace-with-published-runner-digest
# BRUNO_HERMES_WORKLOAD_IMAGE=ghcr.io/ametel01/bruno-hermes@sha256:replace-with-reviewed-amd64-manifest-digest
# BRUNO_HERMES_DOCKER_CPUS=1
# BRUNO_HERMES_DOCKER_MEMORY=1536m
# BRUNO_HERMES_DOCKER_PIDS_LIMIT=256

# Protected credential-free Verified Release publication. These are configured as
# runner-release-canary environment variables/secrets in GitHub, not production
# provider credentials. Retain both active and previous public keys and OCI identities
# while either bundle remains a rollback candidate.
# BRUNO_RELEASE_APPROVED_SNAPSHOT_OCI_REFERENCE=ghcr.io/ametel01/bruno-runner-snapshot-bundles@sha256:replace-with-oci-manifest-digest
# BRUNO_RELEASE_APPROVED_SNAPSHOT_BUNDLE_DIGEST=sha256:replace-with-canonical-snapshot-bundle-digest
# BRUNO_SNAPSHOT_TRUST_SET={"snapshot-key-id":"replace-with-ed25519-public-key-pem"}
# BRUNO_RELEASE_SIGNING_KEY_ID=release-key-id
# BRUNO_RELEASE_SIGNING_KEY_PEM=replace-with-ed25519-private-key-pem
# BRUNO_RELEASE_TRUST_SET={"release-key-id":"replace-with-ed25519-public-key-pem"}
# BRUNO_RELEASE_PREVIOUS_OCI_REFERENCE=ghcr.io/ametel01/bruno-runner-release-bundles@sha256:replace-with-retained-oci-manifest-digest
# BRUNO_RELEASE_PREVIOUS_BUNDLE_DIGEST=sha256:replace-with-retained-canonical-release-bundle-digest

# Protected production runner admission. Keep full validation as the stock default.
# release_attested is valid only with the exact Approved Snapshot and Verified Release
# selected by protected Rollout Configuration.
# BRUNO_RUNNER_BOOT_VALIDATION_MODE=full
# BRUNO_RUNNER_RELEASE_BUNDLE={"schemaVersion":"bruno.runner.release.bundle.v1","manifest":{},"signature":{}}
# BRUNO_RUNNER_APPROVED_RELEASE_DIGEST=sha256:replace-with-canonical-release-bundle-digest
# BRUNO_RUNNER_RELEASE_TRUST_SET={"release-key-id":"replace-with-ed25519-public-key-pem"}
# BRUNO_RUNNER_APPROVED_SNAPSHOT_OCI=ghcr.io/ametel01/bruno-runner-snapshot-bundles@sha256:replace-with-oci-manifest-digest
# BRUNO_RUNNER_APPROVED_SNAPSHOT_BUNDLE_DIGEST=sha256:replace-with-canonical-snapshot-bundle-digest

# The protected rolling production evaluator signs each append-only latest-100
# Cold-Deployment summary. Keep the private key in hosted secret storage.
# BRUNO_COLD_DEPLOYMENT_SLO_SIGNING_KEY_ID=cold-deployment-slo-key-id
# BRUNO_COLD_DEPLOYMENT_SLO_SIGNING_KEY_PEM=replace-with-ed25519-private-key-pem
# BRUNO_COLD_DEPLOYMENT_SLO_TRUST_SET={"cold-deployment-slo-key-id":"replace-with-ed25519-public-key-pem"}

# Runner-service settings for the manual VPS host.
BRUNO_RUNNER_HOST=127.0.0.1
BRUNO_RUNNER_PORT=3045
# BRUNO_RUNNER_DOCKER_EXECUTABLE=docker
# BRUNO_DOCKER_RUNNER_IMAGE=busybox:1.36
# BRUNO_DOCKER_RUNNER_ARGS_JSON='["sh","-c","while true; do sleep 1; done"]'

# Capability-gated Hermes staging acceptance. These placeholders document the
# final live Telegram smoke prerequisites; keep real values in ignored local or
# hosted secret stores only. The default-disabled durable executor cannot start
# unless all capabilities and both exact authorization sentinels pass.
# BRUNO_HERMES_STAGING_PUBLISHED_IMAGE_REF=ghcr.io/ametel01/bruno-hermes@sha256:replace-with-scanned-amd64-manifest-digest
# BRUNO_HERMES_STAGING_IMAGE_SOURCE_REVISION=replace-with-lowercase-40-hex-source-revision
# BRUNO_HERMES_STAGING_PUBLISH_WORKFLOW_RUN_ID=replace-with-successful-main-publish-run-id
# BRUNO_HERMES_STAGING_ACCEPTANCE_ENABLED=false
# BRUNO_HERMES_STAGING_ACCEPTANCE_BASE_URL=https://staging.example.com/
# BRUNO_HERMES_STAGING_ACCEPTANCE_BEARER_SECRET=replace-with-dedicated-32-to-256-character-secret
# BRUNO_HERMES_STAGING_DIGITALOCEAN_BUDGET_AUTHORIZATION=authorize-basic-4usd-digitalocean-staging
# BRUNO_HERMES_STAGING_ASSISTANT=chatgpt
# Set exactly one matching direct key. Use claude plus the Anthropic variable instead.
# BRUNO_HERMES_STAGING_OPENAI_API_KEY=replace-with-openai-platform-api-key
# BRUNO_HERMES_STAGING_ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# BRUNO_HERMES_STAGING_TELEGRAM_BOT_TOKEN=replace-with-dedicated-telegram-bot-token
# BRUNO_HERMES_STAGING_TELEGRAM_TEST_USER_ID=replace-with-numeric-telegram-user-id
# BRUNO_HERMES_STAGING_TELEGRAM_TEST_CHAT_ID=replace-with-numeric-telegram-chat-id
# BRUNO_HERMES_STAGING_LIVE_SIDE_EFFECT_CONFIRMATION=send-telegram-and-spend-digitalocean-staging

# Ready-mode writes direct OpenAI/Anthropic, Telegram, allowlist, and private API credentials
# encrypted. Generate a 32-byte base64url key, name its version, and retain old
# versions during rotation so existing agent secrets remain decryptable.
# BRUNO_AGENT_SECRET_ACTIVE_KEY_VERSION=v1
# BRUNO_AGENT_SECRET_KEYS_JSON={"v1":"replace-with-32-byte-base64url-key"}

# Opt-in automatic ready-mode agent creation. Set exactly true only in an
# environment that has passed the authorized live smoke. Leave unset or false
# to disable common new-agent setup; the stopped-create API is legacy operator compatibility only.
# BRUNO_READY_AGENT_CREATION_ENABLED=false

# Every accepted Agent Deployment pins this positive integer with its exact
# dispatch, provider, image, validation, and runner-size choices. Increment it
# for each protected default change or rollback; leave it unset for generation 1.
# BRUNO_ROLLOUT_CONFIGURATION_GENERATION=1

# Any value below halts new cold provisioning before validation, persistence,
# or provider effects. Active deployments keep their pinned choices. Allowed
# values: rollout_exercise, ownership_violation, authentication_violation,
# artifact_identity_violation, duplicate_billable_effect, cleanup_violation,
# repeated_functional_failure.
# BRUNO_COLD_PROVISIONING_HALT_REASON=rollout_exercise

# Protects both Vercel reconciliation routes: bounded initial-deployment backlog
# recovery and one-item post-ready runtime convergence. Vercel sends it as
# Authorization: Bearer ... .
# Use a generated 32-256 character bearer-safe value in hosted secret storage.
# CRON_SECRET=replace-with-generated-cron-secret-at-least-32-chars

# Deployment retry wakeups default to protected cron recovery. Set qstash only
# after hosted secrets are configured completely; queue delivery is an accelerator
# and Postgres plus CRON_SECRET remain authoritative recovery.
# BRUNO_DEPLOYMENT_DISPATCH_MODE=cron
# Retryable publication failures exhaust after 12 atomic attempts by default.
# Set an integer from 1 through 100 only when the operating environment needs a
# different bounded recovery budget.
# BRUNO_DEPLOYMENT_WAKEUP_MAX_PUBLISH_ATTEMPTS=12
# QSTASH_TOKEN=replace-with-dedicated-qstash-token
# QSTASH_CURRENT_SIGNING_KEY=replace-with-current-qstash-signing-key
# QSTASH_NEXT_SIGNING_KEY=replace-with-next-qstash-signing-key
