DATABASE_URL=postgres://agentbay:agentbay@127.0.0.1:54329/agentbay
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Temporary authentication transition for issue #233. Unset or `operator`
# preserves the existing Basic-auth barrier. `clerk` requires both Clerk key
# variables and still keeps Basic auth until the dedicated production cutover.
# AGENTBAY_AUTH_TRANSITION_MODE=clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-development-publishable-key
# CLERK_SECRET_KEY=replace-with-development-secret-key

# Dashboard-side manual runner bootstrap. Use placeholders only in committed files.
# AGENTBAY_MANUAL_RUNNER_NAME=Manual VPS Runner
# AGENTBAY_MANUAL_RUNNER_ENDPOINT_URL=https://runner.example.com

# Shared temporary Milestone 11 bearer token for dashboard-to-runner requests.
# Replace locally or in deployment settings; never commit a real value.
AGENTBAY_RUNNER_BEARER_TOKEN=replace-with-manual-runner-token

# Optional DigitalOcean cloud runner provisioning. Use placeholders only in
# committed files; set real values in Vercel or local uncommitted env files.
# AGENTBAY_DIGITALOCEAN_TOKEN=replace-with-digitalocean-token
# AGENTBAY_DIGITALOCEAN_REGION=sfo3
# AGENTBAY_DIGITALOCEAN_SIZE_SLUG=s-1vcpu-512mb-10gb
# AGENTBAY_DIGITALOCEAN_IMAGE=ubuntu-24-04-x64
# AGENTBAY_DIGITALOCEAN_TAGS=agentbay,agentbay-runner
# Defaults to auto-discovering account SSH keys through DigitalOcean. Use none
# only when intentionally creating runners without SSH access.
# AGENTBAY_DIGITALOCEAN_SSH_KEY_IDS=auto
# SSH inbound access is disabled by default even when SSH keys exist. Prefer a
# current operator IP CIDR for smoke tests; use public SSH only temporarily.
# AGENTBAY_DIGITALOCEAN_SSH_SOURCE_CIDRS=203.0.113.5/32
# AGENTBAY_DIGITALOCEAN_ALLOW_PUBLIC_SSH=false

# Runner-service settings for the manual VPS host.
AGENTBAY_RUNNER_HOST=127.0.0.1
AGENTBAY_RUNNER_PORT=3045
# AGENTBAY_RUNNER_DOCKER_EXECUTABLE=docker
# AGENTBAY_DOCKER_RUNNER_IMAGE=busybox:1.36
# AGENTBAY_DOCKER_RUNNER_ARGS_JSON='["sh","-c","while true; do sleep 1; done"]'
