FROM oven/bun:1-alpine

ARG RUNNER_RELEASE_VERSION=development
ARG RUNNER_RELEASE_REVISION=development
ARG RUNNER_SOURCE_URL=https://github.com/ametel01/plingpling

LABEL org.opencontainers.image.source="${RUNNER_SOURCE_URL}"
LABEL org.opencontainers.image.revision="${RUNNER_RELEASE_REVISION}"
LABEL org.opencontainers.image.version="${RUNNER_RELEASE_VERSION}"

RUN apk add --no-cache ca-certificates docker-cli

WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile --production
COPY src/runner-service ./src/runner-service
COPY src/server/agents/agent-id.ts ./src/server/agents/agent-id.ts
COPY src/server/agents/agent-launch-spec.ts ./src/server/agents/agent-launch-spec.ts
COPY src/shared/secret-redaction.ts ./src/shared/secret-redaction.ts

ENV NODE_ENV=production
ENV AGENTBAY_RUNNER_HOST=0.0.0.0

EXPOSE 3045

CMD ["sh", "-c", "bun run runner:bootstrap && set -a && . \"${AGENTBAY_RUNNER_ENV_FILE:-/etc/agentbay/runner.env}\" && set +a && exec bun run runner:service"]
